# Kernel settings added to Armbian's linux-rockchip-current.config for the Raspberry Pi 7-inch DSI screen on the Tinker
# Board S (Armbian doesn't build these): the DSI output, the screen's driver and the parts it uses
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL_RASPBERRYPI_TOUCHSCREEN=m
CONFIG_DRM_TOSHIBA_TC358762=m
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY=m
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
